<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- 전체/소주/맥주 필터 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#E8F5F2"
        android:layout_margin="12dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="전체"
            android:textSize="14sp"
            android:background="@drawable/btn_filter_selected"/>

        <Button
            android:id="@+id/btnSoju"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🍶 소주"
            android:textSize="14sp"
            android:background="@drawable/btn_filter_unselected"/>

        <Button
            android:id="@+id/btnBeer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🍺 맥주"
            android:textSize="14sp"
            android:background="@drawable/btn_filter_unselected"/>

    </LinearLayout>

    <!-- 받은 친구 요청 -->
    <TextView
        android:id="@+id/tvFriendRequestCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="받은 친구 요청 (2)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/layoutFriendRequests"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"/>

    <!-- 내 친구 타이틀 + 친구 추가 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvFriendCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="내 친구 (3명)"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnAddFriend"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="+ 친구 추가"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:background="#4DB8A4"
            android:paddingHorizontal="16dp"/>

    </LinearLayout>

    <!-- 친구 랭킹 목록 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFriendRanking"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="12dp"
        android:clipToPadding="false"/>

    <!-- 내 카드 고정 -->
    <LinearLayout
        android:id="@+id/layoutMyCard"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#4DB8A4">

        <TextView
            android:id="@+id/tvMyRank"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="#4"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvMyProfileInitial"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="소"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#3DA898"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvMyNickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="소주마스터 (나)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/tvMyCups"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="312잔"
                android:textSize="13sp"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>